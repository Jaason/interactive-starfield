{
  "name": "interactive-starfield",
  "version": "0.0.0",
  "private": true,
  "description": "A lightweight, dependency-free Canvas 2D starfield library.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "verify:api": "node scripts/verify-api.mjs",
    "verify:lifecycle": "node scripts/verify-lifecycle.mjs",
    "verify:presets": "node scripts/verify-presets.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --project tests/types/tsconfig.json",
    "benchmark": "vite --config benchmark/vite.config.js",
    "build:benchmark": "vite build --config benchmark/vite.config.js"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
}
